<UserControl x:Class="GuiBuddy.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">
    <UserControl.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Window Selection Trigger -->
            <RowDefinition Height="*"/>    <!-- Chat Log -->
            <RowDefinition Height="Auto"/> <!-- Input Area -->
        </Grid.RowDefinitions>

        <!-- Window Selection Area -->
        <DockPanel>
            <!-- Settings Button (Bottom Left) -->
            <StackPanel DockPanel.Dock="Right" Orientation="Vertical">
                <Button Command="{Binding OpenSettingsCommand}" 
                        Content="&#xE713;" 
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="API設定"/>
            </StackPanel>
            <Border Grid.Row="0" Padding="10" Background="#F0F0F0" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="Target Window Selection" FontWeight="Bold" Margin="0,0,0,5"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Left" 
                                Command="{Binding RefreshWindowsCommand}" 
                                Content="&#xE72C;" 
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Refresh Windows"/>
                        <ComboBox 
                                ItemsSource="{Binding AvailableWindows}" 
                                SelectedItem="{Binding SelectedTargetWindow.Value}"
                                DisplayMemberPath="Title"
                                Margin="0,0,5,0"
                                Padding="4"
                                SelectionChanged="TargetWindow_SelectionChanged"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Chat Log -->
        <ListBox x:Name="ChatListBox"
                 ItemsSource="{Binding Messages}" 
                 Grid.Row="1" 
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 Loaded="ChatListBox_Loaded">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="5" Background="#F0F0F0" Padding="8" Margin="5">
                        <StackPanel>
                            <TextBlock Text="{Binding Sender}" FontWeight="Bold" Foreground="#0078D7" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Input Area -->
        <DockPanel Grid.Row="2" Margin="5">
            <Button Content="&#xE724;" 
                    DockPanel.Dock="Right" 
                    Command="{Binding SendCommand}" 
                    Style="{StaticResource IconButtonStyle}"
                    Margin="5,0,0,0" 
                    FontSize="18" 
                    ToolTip="送信 (Shift+Enter)"/>
            <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                     Height="60" 
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="InputTextBox_PreviewKeyDown"/>
        </DockPanel>
    </Grid>
</UserControl>
