<Window x:Class="GuiBuddy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuiBuddy.App"
        xmlns:views="clr-namespace:GuiBuddy.App.Views"
        mc:Ignorable="d"
        Title="GuiBuddy" Height="800" Width="400">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10">
        <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="Debug" Command="{Binding ToggleDebugCommand}" Width="100"/>
            <DockPanel>
                <views:DebugView DataContext="{Binding DebugViewModel}" DockPanel.Dock="Left" Visibility="{Binding IsDebugVisible.Value, Converter={StaticResource BoolToVis}}"/>
                <views:ChatView DataContext="{Binding ChatViewModel}"/>
            </DockPanel>
        </DockPanel>
    </Grid>
</Window>

