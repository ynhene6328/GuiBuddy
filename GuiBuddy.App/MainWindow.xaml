<Window x:Class="GuiBuddy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuiBuddy.App"
        mc:Ignorable="d"
        Title="GuiBuddy Debug" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="{Binding StatusMessage.Value}" FontSize="14" Margin="0,0,0,10"/>

        <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow.Value}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Handle}" Width="80" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Title}" Margin="10,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Center"/>

        <TabControl Grid.Row="1" Grid.Column="2">
            <TabItem Header="Tree Structure">
                <TreeView ItemsSource="{Binding Structure}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="[" Foreground="Blue"/>
                                <TextBlock Text="{Binding ControlType}" Foreground="Blue"/>
                                <TextBlock Text="] " Foreground="Blue"/>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock Text=" (#" Foreground="Gray"/>
                                <TextBlock Text="{Binding AutomationId}" Foreground="Gray"/>
                                <TextBlock Text=")" Foreground="Gray"/>
                                <TextBlock Text=" "/>
                                <TextBlock Text="{Binding Bounds}" FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </TabItem>
            <TabItem Header="Internal Map (JSON)">
                <TextBox Text="{Binding UIMapJson.Value}" IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"/>
            </TabItem>
            <TabItem Header="AI Map (JSON)">
                <TextBox Text="{Binding AiMapJson.Value}" IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"/>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Refresh Windows" Command="{Binding RefreshCommand}" Width="120" Height="30"/>
            <Button Content="Get Structure" Command="{Binding GetStructureCommand}" Width="120" Height="30" Margin="10,0,0,0"/>
            <Button Content="Generate UI Map" Command="{Binding GenerateMapCommand}" Width="120" Height="30" Margin="10,0,0,0"/>
            <Button Content="Show Overlay" Command="{Binding ShowOverlayCommand}" Width="120" Height="30" Margin="10,0,0,0"/>
            <Button Content="Close Overlay" Command="{Binding CloseOverlayCommand}" Width="120" Height="30" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
